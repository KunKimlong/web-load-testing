# Copy to .env (repo root for Docker Compose, or backend/.env for local dev). No real secrets here.

# development | production | test  (production refuses to start without token auth)
LOADLAB_ENVIRONMENT=development
LOADLAB_LOG_LEVEL=INFO

# SQLite (default) or PostgreSQL, e.g. postgresql+asyncpg://loadlab:CHANGE_ME@db:5432/loadlab
LOADLAB_DATABASE_URL=sqlite+aiosqlite:///./data/loadlab.db

# Authentication: "none" is only safe when the API is bound to 127.0.0.1.
# For token mode, generate one per user: python -c "import secrets; print(secrets.token_urlsafe(32))"
LOADLAB_AUTH_MODE=none
# LOADLAB_AUTH_TOKEN=replace-with-a-long-random-token,another-token-for-a-second-user

# Browser origins allowed to call the API (comma separated, no wildcards).
LOADLAB_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Target policy. Only these hosts may resolve to loopback/private IPs.
LOADLAB_LOCAL_TARGET_HOSTS=localhost,127.0.0.1,::1
# Public internet targets are refused unless enabled. Only enable for systems you are authorized to test.
LOADLAB_ALLOW_EXTERNAL_TARGETS=false

# Hard safety limits (users may lower these in Settings, never raise them).
LOADLAB_HARD_MAX_RPS=500
LOADLAB_HARD_MAX_CONCURRENCY=200
LOADLAB_HARD_MAX_DURATION_S=1800
LOADLAB_HARD_MAX_TIMEOUT_S=60
LOADLAB_HARD_MAX_REQUEST_BODY_BYTES=262144
LOADLAB_RESPONSE_BODY_LIMIT_BYTES=65536
LOADLAB_MAX_ACTIVE_TESTS_TOTAL=4
LOADLAB_MAX_ACTIVE_TESTS_PER_OWNER=2
LOADLAB_MAX_PAUSE_S=600

# Rate limit for LoadLab's own API (per client IP).
LOADLAB_API_RATE_LIMIT_PER_S=20
LOADLAB_API_RATE_LIMIT_BURST=60
LOADLAB_TEST_START_LIMIT_PER_MIN=10

# Frontend (build time)
NEXT_PUBLIC_API_URL=http://localhost:8000
